    },
    {
      "source": "/aio-aeo-geo",
      "destination": "/aioaeogeo",
      "permanent": true
    },
    {
      "source": "/fundamentals-of-seo",
      "destination": "/seo-fundamentals",
      "permanent": true
    },
    {
      "source": "/untitled",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/seo",
